# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB 6 or later. Atlas: mongodb+srv://user:pass@cluster.mongodb.net/shieldops
MONGODB_URI=mongodb://127.0.0.1:27017/shieldops

# Where the frontend runs. Invite links point here; requests from any other origin are refused.
APP_URL=http://localhost:5173
# Extra allowed origins, comma separated (optional)
EXTRA_ORIGINS=

# 32 random bytes, base64. Encrypts the SMTP password and integration credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it means re-entering those credentials. Keep a copy in your password manager.
ENCRYPTION_KEY=

# Session cookie. In production behind HTTPS keep COOKIE_SECURE=true.
COOKIE_SECURE=false
# Set when the API and frontend are on different subdomains, e.g. .example.com
COOKIE_DOMAIN=
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
REAUTH_MINUTES=10

# Number of proxies in front of the API (nginx = 1), so client IPs are read correctly.
TRUST_PROXY=1
LOG_LEVEL=info

# ── GitHub App (phase 5) ── see README "Connect GitHub". Leave empty until then.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Path to the .pem file GitHub gave you (recommended), or the key itself with \n for line breaks.
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_APP_PRIVATE_KEY=
# Any long random string; paste the same value into the app's webhook settings.
GITHUB_WEBHOOK_SECRET=

# ── Scanners (phase 5) ── installed by scripts/install-scanners.sh into /usr/local/bin.
# SCANNER_BIN_DIR=/usr/local/bin
# SCAN_TIMEOUT_SEC=900
# SCAN_CACHE_DIR=/var/cache/shieldops-scanners

# ── Alert webhooks (phase 6) ── only if your webhook endpoint uses a certificate from your own CA.
# WEBHOOK_CA_FILE=/etc/shieldops/internal-ca.pem

# ── AI analyst (phase 7) ── off until you turn it on and approve sharing in System settings.
# Set only the provider you choose there. Keys stay here, never in the database.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21

# ── AWS (phase 8) ── keys of a small IAM user whose ONLY permission is sts:AssumeRole on your
# ShieldOps read-only role (see README "Connect AWS"). Leave empty if you do not connect AWS.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Regions to scan, comma-separated (the first is also used for account-wide checks).
# AWS_REGIONS=ap-south-1