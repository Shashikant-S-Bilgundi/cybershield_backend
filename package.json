{
  "name": "shieldops-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ShieldOps backend: Express, TypeScript and MongoDB.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "3.1164.0",
    "@aws-sdk/client-ec2": "3.1164.0",
    "@aws-sdk/client-iam": "3.1164.0",
    "@aws-sdk/client-rds": "3.1164.0",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/client-sts": "3.1164.0",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cron-parser": "^5.10.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.10",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "tldts": "^7.5.5",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}